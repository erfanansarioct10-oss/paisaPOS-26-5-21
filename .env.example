# PaisaPOS Environment Variables Example
# Duplicate this file as '.env.local' for local development, or configure the
# same keys in Vercel/Supabase project secrets for beta.

# Public Supabase client settings. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-api-key

# Canonical public app origin. Must match Supabase Auth redirect URLs.
APP_URL=https://your-beta-domain.example

# Runtime environment. Vercel sets NODE_ENV automatically during builds.
NODE_ENV=development

# Server-only Supabase key for admin-only audit/test utilities.
# Never prefix this with NEXT_PUBLIC_ and never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Distributed rate limiting. Required for production beta on serverless/edge.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Fail closed when Redis rate limiting is unreachable in production.
RATE_LIMIT_FAIL_CLOSED=true

# Trust forwarded IP headers only when your platform sanitizes them.
# Vercel can leave this unset; set false for unknown reverse proxies.
TRUST_PROXY_HEADERS=true

# Optional: run E2E against a deployed preview/beta instead of localhost.
# PLAYWRIGHT_BASE_URL=https://your-preview-or-beta-url.example

# Optional local-only Supabase CLI release checks. Do not configure this as a
# browser/client variable or expose it in public build logs.
# SUPABASE_DB_PASSWORD=your-supabase-database-password
# Custom SMTP Settings